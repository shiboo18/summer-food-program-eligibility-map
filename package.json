{
  "name": "@amzn/share-our-strengths-app",
  "productName": "vibeCheck",
  "version": "0.1.0",
  "description": "vibeCheck desktop address validation tool.",
  "author": "Share Our Strength with Amazon",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "ssh://git.amazon.com/pkg/ShareOurStrengthsApp"
  },
  "homepage": "https://code.amazon.com/packages/ShareOurStrengthsApp",
  "type": "module",
  "main": "./packages/desktop/dist/main/main.js",
  "workspaces": [
    "packages/backend",
    "packages/desktop"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "run-app": "bash scripts/run-app.sh",
    "clean": "rm -rf packages/*/dist build/typescript node_modules",
    "clean:build": "rm -rf packages/*/dist build/typescript",
    "build": "npm run clean:build && tsc -b && node scripts/copy-static.mjs",
    "start": "npm run build && electron .",
    "smoke": "npm run build && electron . --smoke-test",
    "watch": "tsc -b -w",
    "typecheck:tests": "tsc -b && tsc -p packages/backend/tsconfig.spec.json && tsc -p packages/desktop/tsconfig.spec.json",
    "prepublishOnly": "npm run build && npm run test",
    "test": "vitest run --coverage",
    "posttest": "generate-coverage-data --language typescript",
    "package": "npm run package:prepare && electron-builder --mac --win --config electron-builder.yml && npm run package:prune",
    "package:prepare": "npm run build && node scripts/fix-smarty-tslib.mjs",
    "package:prune": "rm -f build/electron/*-x64-setup.exe build/electron/*-x64-setup.exe.blockmap build/electron/*-arm64-setup.exe build/electron/*-arm64-setup.exe.blockmap",
    "package:mac": "npm run package:prepare && electron-builder --mac --config electron-builder.yml",
    "package:win": "npm run package:prepare && electron-builder --win --config electron-builder.yml && npm run package:prune"
  },
  "files": [
    "packages/backend/dist/",
    "packages/backend/package.json",
    "packages/desktop/dist/",
    "packages/desktop/package.json"
  ],
  "npm-pretty-much": {
    "runTest": "never"
  },
  "dependencies": {
    "exceljs": "4.4.0",
    "ky": "2.1.0",
    "smartystreets-javascript-sdk": "13.0.0",
    "tslib": "2.8.1"
  },
  "devDependencies": {
    "@amzn/brazil": "^2.2.3",
    "@tsconfig/node24": "^24.0.4",
    "@types/node": "24.13.4",
    "@vitest/coverage-v8": "^4.1.2",
    "electron-builder": "26.3.6",
    "typescript": "~7.0.2",
    "typescript-language-server": "6.0.0",
    "typescript-lsp": "npm:typescript@5.9.3",
    "vitest": "^4.1.2"
  }
}
